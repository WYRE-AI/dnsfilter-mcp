# DNSFilter API key, generated in the DNSFilter dashboard under Account
# Settings -> Security -> API Keys (max 5 active keys per account). Sent as
# the RAW Authorization header value - no "Bearer" prefix - per DNSFilter's
# own API docs. This connector only ever holds a live key.
# Used by stdio and by HTTP when AUTH_MODE=env. The gateway Compose service
# does not load this. Do not add it to that service's environment or via env_file.
DNSFILTER_API_KEY=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# env (default; stdio and single-tenant HTTP) or gateway (X-DNSFilter-Api-Key
# on each /mcp request; no DNSFILTER_API_KEY fallback). The image and Compose
# default to gateway.
# AUTH_MODE=env

# Required to start the HTTP transport. Leave this empty. The process exits
# if it is empty or a known placeholder (changeme, placeholder, secret, ...),
# so a copied example cannot forge X-Gateway-S2S. Compose will not start when
# it is unset. Never commit a real value.
# Generate one with: openssl rand -hex 32
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The process logs a warning, does not check
# X-Gateway-S2S, and listens on 127.0.0.1 only. A wider MCP_HTTP_HOST is
# ignored. A known placeholder secret is still refused. Do not use in production.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Defaults to 127.0.0.1
# when unset. The container image sets 0.0.0.0. Without a secret, the
# listener is forced to 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# LOG_LEVEL=info
